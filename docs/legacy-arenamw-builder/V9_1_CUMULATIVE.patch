-        val realX = (x * scaleX).toInt()
-        val realY = (y * scaleY).toInt()
-
-        val screenWidth = (getVirtualWidth() * uniformScale).toInt()
-        val screenHeight = (getVirtualHeight() * uniformScale).toInt()
