-            putInt("osc:$uniqueId:size", size)
-            putInt("osc:$uniqueId:x", x)
-            putInt("osc:$uniqueId:y", y)
-
-            commit()
-        }
-    }
-
-    fun loadPrefs(ctx: Context) {
