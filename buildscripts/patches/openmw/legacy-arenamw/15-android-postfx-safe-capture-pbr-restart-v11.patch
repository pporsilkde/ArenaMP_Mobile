@@ -0,0 +1,22 @@
+#version 120
+varying vec2 vUv;
+uniform sampler2D edgeTexture;
+uniform vec2 inverseSceneSize;
+void main()
+{
+    vec2 e = texture2D(edgeTexture, vUv).rg;
+    float left = 0.0; float right = 0.0; float up = 0.0; float down = 0.0;
+    if (e.x > 0.0)
+    {
+        for (int i=1; i<=8; ++i) { if (texture2D(edgeTexture, clamp(vUv-vec2(inverseSceneSize.x*float(i),0.0),vec2(0.0),vec2(1.0))).r < 0.5) break; left += 1.0; }
+        for (int i=1; i<=8; ++i) { if (texture2D(edgeTexture, clamp(vUv+vec2(inverseSceneSize.x*float(i),0.0),vec2(0.0),vec2(1.0))).r < 0.5) break; right += 1.0; }
+    }
+    if (e.y > 0.0)
+    {
+        for (int i=1; i<=8; ++i) { if (texture2D(edgeTexture, clamp(vUv-vec2(0.0,inverseSceneSize.y*float(i)),vec2(0.0),vec2(1.0))).g < 0.5) break; down += 1.0; }
+        for (int i=1; i<=8; ++i) { if (texture2D(edgeTexture, clamp(vUv+vec2(0.0,inverseSceneSize.y*float(i)),vec2(0.0),vec2(1.0))).g < 0.5) break; up += 1.0; }
+    }
+    float hsum = left + right + 1.0;
+    float vsum = up + down + 1.0;
+    gl_FragColor = vec4(right/hsum, left/hsum, up/vsum, down/vsum) * 0.72;
+}
