@@ -0,0 +1,16 @@
+#version 120
+varying vec2 vUv;
+uniform sampler2D bloomTexture;
+uniform vec2 inverseBloomSize;
+uniform float bloomRadius;
+vec3 sampleBloom(vec2 uv) { return texture2D(bloomTexture, clamp(uv, vec2(0.0), vec2(1.0))).rgb; }
+void main()
+{
+    vec2 stepUv = vec2(0.0, inverseBloomSize.y * max(bloomRadius * 0.5, 0.5));
+    vec3 color = sampleBloom(vUv) * 0.22702703;
+    color += sampleBloom(vUv + stepUv * 1.38461538) * 0.31621622;
+    color += sampleBloom(vUv - stepUv * 1.38461538) * 0.31621622;
+    color += sampleBloom(vUv + stepUv * 3.23076923) * 0.07027027;
+    color += sampleBloom(vUv - stepUv * 3.23076923) * 0.07027027;
+    gl_FragColor = vec4(color, 1.0);
+}
diff --git a/files/shaders/mobile_depth.frag b/files/shaders/mobile_depth.frag
new file mode 100644
index 0000000..f83443c
--- /dev/null
+++ b/files/shaders/mobile_depth.frag
@@ -0,0 +1,15 @@
+#version 120
+vec3 packDepth24(float depth)
+{
+    float x = clamp(depth, 0.0, 1.0);
+    float r = fract(x);
+    float g = fract(x * 255.0);
+    float b = fract(x * 65025.0);
+    r -= g / 255.0;
+    g -= b / 255.0;
+    return vec3(r, g, b);
+}
+void main()
+{
+    gl_FragColor = vec4(packDepth24(gl_FragCoord.z), 1.0);
+}
