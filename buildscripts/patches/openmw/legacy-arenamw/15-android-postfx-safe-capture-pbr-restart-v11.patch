diff --git a/files/shaders/mobile_smaa_edge.frag b/files/shaders/mobile_smaa_edge.frag
new file mode 100644
index 0000000..effa183
--- /dev/null
+++ b/files/shaders/mobile_smaa_edge.frag
@@ -0,0 +1,26 @@
+#version 120
+varying vec2 vUv;
+uniform sampler2D sceneTexture;
+uniform sampler2D depthTexture;
+uniform vec2 inverseSceneSize;
+uniform float smaaThreshold;
+float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
+float unpackDepth(vec3 p) { return p.r + p.g / 255.0 + p.b / 65025.0; }
+float readDepth(vec2 uv) { return unpackDepth(texture2D(depthTexture, uv).rgb); }
+void main()
+{
+    vec2 dx = vec2(inverseSceneSize.x, 0.0);
+    vec2 dy = vec2(0.0, inverseSceneSize.y);
+    vec2 lUv = clamp(vUv-dx, vec2(0.0), vec2(1.0));
+    vec2 tUv = clamp(vUv-dy, vec2(0.0), vec2(1.0));
+    float c = luma(texture2D(sceneTexture, vUv).rgb);
+    float l = luma(texture2D(sceneTexture, lUv).rgb);
+    float t = luma(texture2D(sceneTexture, tUv).rgb);
+    float d = readDepth(vUv);
+    float dl = readDepth(lUv);
+    float dt = readDepth(tUv);
+    float threshold = clamp(smaaThreshold, 0.02, 0.35);
+    float ex = max(abs(c-l) / max(max(c,l), 0.08), abs(d-dl) * 18.0);
+    float ey = max(abs(c-t) / max(max(c,t), 0.08), abs(d-dt) * 18.0);
+    gl_FragColor = vec4(step(threshold, ex), step(threshold, ey), 0.0, 1.0);
+}
diff --git a/files/shaders/mobile_smaa_weights.frag b/files/shaders/mobile_smaa_weights.frag
