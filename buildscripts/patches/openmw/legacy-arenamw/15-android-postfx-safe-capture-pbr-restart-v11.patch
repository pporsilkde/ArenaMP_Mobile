+    m*=max(hdrBrightness,0.0);float l=dot(m,vec3(0.2126,0.7152,0.0722));m=mix(vec3(l),m,max(hdrSaturation,0.0));return pow3(clamp(m,0.0,1.0),1.0/max(hdrGamma,0.1));
+}
+void main()
+{
+    vec2 uv=vUv; vec3 color=texture2D(sceneTexture,uv).rgb;
+    if(smaaEnabled>=0.5)
+    {
+        vec4 w=texture2D(weightTexture,uv);float hw=clamp(w.x+w.y,0.0,0.92),vw=clamp(w.z+w.w,0.0,0.92);
+        vec3 h=texture2D(sceneTexture,clamp(uv-vec2(inverseSceneSize.x,0.0),vec2(0.0),vec2(1.0))).rgb*w.x+texture2D(sceneTexture,clamp(uv+vec2(inverseSceneSize.x,0.0),vec2(0.0),vec2(1.0))).rgb*w.y;
+        vec3 v=texture2D(sceneTexture,clamp(uv-vec2(0.0,inverseSceneSize.y),vec2(0.0),vec2(1.0))).rgb*w.z+texture2D(sceneTexture,clamp(uv+vec2(0.0,inverseSceneSize.y),vec2(0.0),vec2(1.0))).rgb*w.w;
+        float total=hw+vw;if(total>0.0001)color=mix(color,(h+v)/total,clamp(total*0.72,0.0,0.82));
+    }
+    if(bloomEnabled>=0.5)color+=texture2D(bloomTexture,uv).rgb*max(bloomIntensity,0.0);
+    if(hdrPostEnabled>=0.5)color=applyHdr(color);
+    gl_FragColor=vec4(color,1.0);
+}
diff --git a/files/shaders/mobile_native_effects.frag b/files/shaders/mobile_native_effects.frag
new file mode 100644
index 0000000..4c636da
--- /dev/null
+++ b/files/shaders/mobile_native_effects.frag
@@ -0,0 +1,100 @@
+#version 120
+varying vec2 vUv;
+uniform sampler2D sceneTexture;
+uniform sampler2D depthTexture;
+uniform vec2 inverseSceneSize;
+uniform mat4 inverseProjectionMatrix;
+uniform mat4 projectionMatrix;
+uniform float ssrEnabled;
+uniform float ssrStrength;
+uniform float ssrDistance;
+const int SSR_STEPS = 24;
+const int SSR_BINARY_STEPS = 4;
+float unpackDepth(vec3 p) { return p.r + p.g / 255.0 + p.b / 65025.0; }
+float readDepth(vec2 uv) { return unpackDepth(texture2D(depthTexture, uv).rgb); }
+vec3 reconstructViewPosition(vec2 uv, float depth)
+{
+    vec4 clip = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
+    vec4 view = inverseProjectionMatrix * clip;
+    float w = view.w;
+    if (abs(w) < 0.000001) w = w < 0.0 ? -0.000001 : 0.000001;
+    return view.xyz / w;
+}
+vec3 sampleViewPosition(vec2 uv) { return reconstructViewPosition(uv, readDepth(uv)); }
+vec2 projectViewPosition(vec3 p)
+{
+    vec4 clip = projectionMatrix * vec4(p, 1.0);
+    if (clip.w <= 0.00001) return vec2(-1.0, -1.0);
+    return clip.xy / clip.w * 0.5 + 0.5;
+}
+bool insideScreen(vec2 uv) { return uv.x > 0.001 && uv.y > 0.001 && uv.x < 0.999 && uv.y < 0.999; }
+vec3 reconstructNormal(vec2 uv, vec3 p)
+{
+    vec2 dx=vec2(inverseSceneSize.x,0.0); vec2 dy=vec2(0.0,inverseSceneSize.y);
+    vec3 pL=sampleViewPosition(clamp(uv-dx,vec2(0.0),vec2(1.0)));
+    vec3 pR=sampleViewPosition(clamp(uv+dx,vec2(0.0),vec2(1.0)));
+    vec3 pD=sampleViewPosition(clamp(uv-dy,vec2(0.0),vec2(1.0)));
+    vec3 pU=sampleViewPosition(clamp(uv+dy,vec2(0.0),vec2(1.0)));
+    vec3 a=pR-p; vec3 b=p-pL; vec3 c=pU-p; vec3 d=p-pD;
+    vec3 sx = dot(a,a) < dot(b,b) ? a : b;
+    vec3 sy = dot(c,c) < dot(d,d) ? c : d;
+    vec3 n=cross(sx,sy); float q=dot(n,n);
+    if (q < 0.0000000001) return normalize(-p);
+    n *= inversesqrt(q); if (dot(n,-p)<0.0) n=-n; return n;
+}
+float rayDelta(vec3 rayPos, vec2 uv, out float sceneDepth)
+{
+    float d=readDepth(uv); if (d>=0.99995) { sceneDepth=100000000.0; return 100000000.0; }
+    vec3 sp=reconstructViewPosition(uv,d); sceneDepth=max(-sp.z,0.0); return max(-rayPos.z,0.0)-sceneDepth;
+}
+vec3 reflectionColor(vec2 uv,float blur)
+{
+    vec2 px=inverseSceneSize*blur; vec3 c=texture2D(sceneTexture,uv).rgb*0.50;
+    c+=texture2D(sceneTexture,clamp(uv+vec2(px.x,0.0),vec2(0.0),vec2(1.0))).rgb*0.125;
+    c+=texture2D(sceneTexture,clamp(uv-vec2(px.x,0.0),vec2(0.0),vec2(1.0))).rgb*0.125;
+    c+=texture2D(sceneTexture,clamp(uv+vec2(0.0,px.y),vec2(0.0),vec2(1.0))).rgb*0.125;
+    c+=texture2D(sceneTexture,clamp(uv-vec2(0.0,px.y),vec2(0.0),vec2(1.0))).rgb*0.125; return c;
+}
+void main()
+{
+    vec2 uv=vUv; vec3 color=texture2D(sceneTexture,uv).rgb; float depth=readDepth(uv);
+    if (ssrEnabled>=0.5 && depth<0.9998)
+    {
+        vec3 vp=reconstructViewPosition(uv,depth); vec3 N=reconstructNormal(uv,vp); vec3 I=normalize(vp); vec3 R=normalize(reflect(I,N));
+        float ndv=clamp(dot(N,-I),0.0,1.0); float fresnel=0.06+0.94*pow(1.0-ndv,3.0);
+        float rz=smoothstep(0.045,0.28,abs(R.z)); float maxD=max(ssrDistance,64.0); float minT=max(3.0,abs(vp.z)*0.0012);
+        vec3 origin=vp+N*max(0.35,abs(vp.z)*0.00025); float prevT=minT; vec3 prevP=origin+R*prevT; vec2 prevUv=projectViewPosition(prevP);
+        float prevSD=0.0; float prevDelta=0.0; bool prevValid=false;
+        if (insideScreen(prevUv)) { prevDelta=rayDelta(prevP,prevUv,prevSD); prevValid=prevSD<99999999.0; }
+        vec2 hitUv=vec2(-1.0,-1.0); float hitT=0.0; float hit=0.0;
+        for (int i=1;i<=SSR_STEPS;++i)
+        {
+            float f=float(i)/float(SSR_STEPS); float tt=minT+(maxD-minT)*f*f; vec3 rp=origin+R*tt; vec2 ru=projectViewPosition(rp); if(!insideScreen(ru)) break;
+            float sd=0.0; float delta=rayDelta(rp,ru,sd); bool valid=sd<99999999.0;
+            if(valid && prevValid)
+            {
+                bool crossed=(R.z<0.0 && prevDelta<0.0 && delta>=0.0)||(R.z>0.0 && prevDelta>0.0 && delta<=0.0);
+                if(crossed)
+                {
+                    float lo=prevT; float hi=tt; vec2 refined=ru; float refinedSD=sd;
+                    for(int j=0;j<SSR_BINARY_STEPS;++j)
+                    {
+                        float mid=0.5*(lo+hi); vec3 mp=origin+R*mid; vec2 mu=projectViewPosition(mp); if(!insideScreen(mu)) break;
+                        float msd=0.0; float md=rayDelta(mp,mu,msd); if(msd>=99999999.0){lo=mid;continue;}
+                        bool farSide=(R.z<0.0)?(md>=0.0):(md<=0.0); if(farSide){hi=mid;refined=mu;refinedSD=msd;}else lo=mid;
+                    }
+                    vec3 hp=origin+R*hi; float rd=max(-hp.z,0.0); float thick=max(2.0,refinedSD*0.0045);
+                    if(abs(rd-refinedSD)<=thick*2.0){hitUv=refined;hitT=hi;hit=1.0;break;}
+                }
+            }
+            prevT=tt; prevDelta=delta; prevValid=valid;
+        }
+        if(hit>0.5)
+        {
+            float edge=min(min(hitUv.x,hitUv.y),min(1.0-hitUv.x,1.0-hitUv.y)); float ef=smoothstep(0.015,0.11,edge);
+            float travel=clamp(hitT/maxD,0.0,1.0); float df=1.0-smoothstep(0.55,1.0,travel); float conf=ef*df*rz;
+            vec3 hc=reflectionColor(hitUv,1.0+travel*2.0); float refl=min(clamp(ssrStrength,0.0,1.0)*fresnel*conf,0.72); color=mix(color,hc,refl);
+        }
+    }
+    gl_FragColor=vec4(color,1.0);
+}
