diff --git a/files/shaders/mobile_bloom_horizontal.frag b/files/shaders/mobile_bloom_horizontal.frag
new file mode 100644
index 0000000..d9f20df
--- /dev/null
+++ b/files/shaders/mobile_bloom_horizontal.frag
@@ -0,0 +1,28 @@
+#version 120
+varying vec2 vUv;
+uniform sampler2D sceneTexture;
+uniform vec2 inverseSceneSize;
+uniform vec2 inverseBloomSize;
+uniform float bloomThreshold;
+uniform float bloomSoftKnee;
+uniform float bloomRadius;
+vec3 brightPart(vec3 color)
+{
+    float luminance = dot(color, vec3(0.2126, 0.7152, 0.0722));
+    float knee = max(bloomThreshold * bloomSoftKnee, 0.0001);
+    float soft = clamp((luminance - bloomThreshold + knee) / (2.0 * knee), 0.0, 1.0);
+    soft = soft * soft * (3.0 - 2.0 * soft);
+    float contribution = max(luminance - bloomThreshold, 0.0) + soft * knee;
+    return color * (contribution / max(luminance, 0.0001));
+}
+vec3 sampleBright(vec2 uv) { return brightPart(texture2D(sceneTexture, clamp(uv, vec2(0.0), vec2(1.0))).rgb); }
+void main()
+{
+    vec2 stepUv = vec2(inverseSceneSize.x * max(bloomRadius, 0.5), 0.0);
+    vec3 color = sampleBright(vUv) * 0.22702703;
+    color += sampleBright(vUv + stepUv * 1.38461538) * 0.31621622;
+    color += sampleBright(vUv - stepUv * 1.38461538) * 0.31621622;
+    color += sampleBright(vUv + stepUv * 3.23076923) * 0.07027027;
+    color += sampleBright(vUv - stepUv * 3.23076923) * 0.07027027;
+    gl_FragColor = vec4(color, 1.0);
+}
diff --git a/files/shaders/mobile_bloom_vertical.frag b/files/shaders/mobile_bloom_vertical.frag
