+            if (value[i] != '\\' || i + 1 >= value.size())
+            {
+                result.push_back(value[i]);
+                continue;
+            }
+            const char next = value[++i];
+            if (next == 'n') result.push_back('\n');
+            else if (next == 't') result.push_back('\t');
+            else result.push_back(next);
+        }
+        return result;
+    }
