+                case 3: chatChannel = CHANNEL_WHISPER; break;
+                case 4: chatChannel = CHANNEL_SHOUT; break;
+                case 5: chatChannel = CHANNEL_LOCAL_OOC; break;
+                case 2:
+                default: chatChannel = CHANNEL_SAY; break;
