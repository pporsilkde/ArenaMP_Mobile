+    std::size_t utf8Length(const std::string& text)
+    {
+        std::size_t count = 0;
+        for (std::size_t i = 0; i < text.size(); ++i)
+        {
+            const unsigned char c = static_cast<unsigned char>(text[i]);
+            if (c < 0x80 || c >= 0xC0)
