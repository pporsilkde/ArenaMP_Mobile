+    void GUIChat::applyChatState(const std::vector<std::string>& fields)
+    {
+        if (fields.size() > 3)
+        {
+            const bool serverRp = fields[3] == "1";
+            if (serverRp != rpMode)
+                setRpMode(serverRp);
+        }
