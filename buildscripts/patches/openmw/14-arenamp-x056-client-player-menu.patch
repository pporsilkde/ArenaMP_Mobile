+        sayHoldArmed = false;
+        sayHoldTriggered = false;
+        sayHoldTime = 0.f;
+        return;
+    }
+
+    if (sayHoldTriggered)
+        return;
+
+    sayHoldTime += std::max(0.f, dt);
+    if (sayHoldTime >= sayHoldThreshold)
+    {
+        sayHoldTriggered = true;
