+// NG-GL4ES' simple GLES converter is reliable for scalar pow(), but some
+// mobile drivers reject the generated vec3 overload. Keep the same maths and
+// evaluate the three channels explicitly so HDR is usable on Android as well.
+vec3 arenaPow3(vec3 x, float exponent)
+{
+    return vec3(
+        pow(max(x.x, 0.0), exponent),
+        pow(max(x.y, 0.0), exponent),
+        pow(max(x.z, 0.0), exponent));
+}
+
 vec3 preLight(vec3 x)
 {
