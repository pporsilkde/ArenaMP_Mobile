diff --git a/server/scripts/logicHandler.lua b/server/scripts/logicHandler.lua
index 3274ef9ba9d10b68df0df6e63d13fa8eff34efa1..f042eebd80002e6fcef1993057a2261852f39f2f 100644
--- a/server/scripts/logicHandler.lua
+++ b/server/scripts/logicHandler.lua
@@ -780,6 +780,74 @@ logicHandler.GetCellContainingActor = function(actorUniqueIndex)
