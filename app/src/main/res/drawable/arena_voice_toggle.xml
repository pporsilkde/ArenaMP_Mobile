<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#E642392A" />
            <stroke android:width="1dp" android:color="#DBB774" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E6383631" />
            <stroke android:width="1dp" android:color="#DBB774" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D91C1E21" />
            <stroke android:width="1dp" android:color="#807D6B4B" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
