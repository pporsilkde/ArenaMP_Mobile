<!--
  ArenaMP U025 — блок настроек голоса.
  Вставляется в res/xml/settings.xml новой категорией перед "pref_advanced".
  Ключи читает FragmentSettings и передаёт в VoiceService.
-->
<PreferenceCategory xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/voice_title" android:key="voice_settings">
    <!-- xmlns здесь только чтобы фрагмент проверялся отдельно; при вставке
         в settings.xml атрибут xmlns убрать, он уже есть на PreferenceScreen -->

    <!-- По умолчанию выключено: первый запуск не должен открывать микрофон -->
    <CheckBoxPreference
        android:key="pref_voice_enabled"
        android:title="@string/voice_enable"
        android:summary="@string/voice_enable_summary"
        android:defaultValue="false" />

    <ListPreference
        android:key="pref_voice_mode"
        android:title="@string/voice_mode"
        android:entries="@array/pref_voice_mode_entries"
        android:entryValues="@array/pref_voice_mode_values"
        android:defaultValue="ptt"
        android:summary="%s" />

    <SeekBarPreference
        android:key="pref_voice_mic_gain"
        android:title="@string/voice_mic_gain"
        android:defaultValue="100"
        android:max="200" />

    <SeekBarPreference
        android:key="pref_voice_volume"
        android:title="@string/voice_volume"
        android:defaultValue="80"
        android:max="100" />

    <!-- Слабые устройства: просим у сервера готовый микс вместо N потоков -->
    <CheckBoxPreference
        android:key="pref_voice_low_power"
        android:title="@string/voice_low_power"
        android:summary="@string/voice_low_power_summary"
        android:defaultValue="false" />

    <Preference
        android:key="pref_voice_permissions"
        android:title="@string/voice_permissions"
        android:summary="@string/voice_permissions_summary" />
</PreferenceCategory>
