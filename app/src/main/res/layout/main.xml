<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/arena_glass_backdrop"
    android:orientation="vertical">

    <!-- Server/build title has its own full-width card. It never competes
         with toolbar actions, and grows vertically for long localized names. -->
    <TextView
        android:id="@+id/arena_launcher_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:minHeight="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="@drawable/arena_glass_card"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:singleLine="false"
        android:text="ArenaMP"
        android:textColor="@color/toolbarTitle"
        android:textSize="20sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent" />

    <!-- Symmetric action bar: settings flank the central state-aware launch action. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:padding="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/arena_glass_card">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/btn_graphics"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/pref_graphics_settings_title"
                    android:padding="12dp"
                    android:src="@drawable/arena_ic_graphics"
                    android:tint="@color/accentGold" />
                <ImageButton
                    android:id="@+id/btn_mods"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/arena_quick_mods"
                    android:padding="12dp"
                    android:src="@drawable/arena_ic_mods"
                    android:tint="@color/accentGold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/btn_controls"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/arena_quick_controls"
                    android:padding="12dp"
                    android:src="@drawable/arena_ic_controls"
                    android:tint="@color/accentGold" />
                <ImageButton
                    android:id="@+id/btn_globe"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/arena_quick_website"
                    android:padding="12dp"
                    android:src="@drawable/arena_ic_globe"
                    android:tint="@color/accentGold" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/arena_action_play"
                android:src="@drawable/arena_ic_play"
                app:fabSize="normal"
                app:backgroundTint="@color/accentGold"
                app:borderWidth="0dp"
                app:elevation="4dp"
                app:pressedTranslationZ="2dp"
                app:useCompatPadding="false"
                app:rippleColor="@color/accentGoldDark"
                app:tint="@color/textOnAccent" />
            <TextView
                android:id="@+id/fab_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/arena_action_play"
                android:textColor="@color/accentGold"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/btn_update"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_update_desc"
                    android:padding="12dp"
                    android:src="@drawable/arena_ic_update"
                    android:tint="@color/accentGold" />
                <ImageButton
                    android:id="@+id/btn_server"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/arena_quick_server"
                    android:padding="12dp"
                    android:src="@drawable/arena_ic_server"
                    android:tint="@color/accentGold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/btn_more"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/arena_more_actions"
                    android:padding="12dp"
                    android:src="@drawable/arena_ic_more"
                    android:tint="@color/accentGold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
