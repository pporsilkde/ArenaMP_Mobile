<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgPrimary"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/main_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbarBackground"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:subtitleTextColor="@color/toolbarSubtitle"
        app:titleTextColor="@color/toolbarTitle">

        <!-- globe: opens morrowind.site -->
        <ImageButton
            android:id="@+id/btn_globe"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_globe_desc"
            android:padding="10dp"
            android:src="@drawable/ic_globe"
            android:tint="@color/toolbarTitle" />

        <!-- download-arrow: triggers update -->
        <ImageButton
            android:id="@+id/btn_update"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_update_desc"
            android:padding="10dp"
            android:src="@drawable/ic_update"
            android:tint="@color/toolbarTitle" />

    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/content_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:background="@color/bgPrimary" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|right"
                android:layout_margin="16dp"
                android:src="@drawable/ic_start_button"
                app:backgroundTint="@color/fabBackground"
                app:borderWidth="0dp"
                app:elevation="8dp"
                app:pressedTranslationZ="0dp"
                app:useCompatPadding="true"
                app:rippleColor="@color/fabRipple"
                app:tint="@null" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
